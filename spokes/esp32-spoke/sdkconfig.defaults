menu "GLaDOS Spoke Configuration"
    config WIFI_SSID
        string "WiFi SSID"
        default "1.21Jigowatts"
        help
            The SSID of your WiFi network

    config WIFI_PASSWORD
        string "WiFi Password"
        default "Jigowatts"
        help
            The password of your WiFi network

    config HUB_HOST
        string "Hub Host"
        default "192.168.1.58"
        help
            The IP address or hostname of the GLaDOS hub

    config HUB_PORT
        int "Hub Port"
        default 5051
        help
            The WebSocket port of the GLaDOS hub

endmenu
